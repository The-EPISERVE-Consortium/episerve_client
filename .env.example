EPISERVE_API_URL=https://your-api-server
EPISERVE_CKAN_URL=https://your-ckan-server
EPISERVE_DOIP_URL=https://your-doip-server
EPISERVE_API_KEY=       # set automatically by "episerve-client login"
EPISERVE_USERNAME=      # optional: used by "episerve-client login" to skip -u flag
EPISERVE_PASSWORD=      # optional: used by "episerve-client login" to skip -p flag
